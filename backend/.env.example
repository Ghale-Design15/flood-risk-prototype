# Backend environment variables. Copy to .env (git-ignored) or set these in the
# Render service's Environment settings. None are needed for the model endpoints;
# the group below powers the /alerts audit log and email dispatch.

# --- Supabase audit store (required for /alerts and /alerts/verify) ---
# Project URL and the SERVICE-ROLE key (Settings > API in the Supabase dashboard).
# Use the service-role key on the server only; it bypasses Row Level Security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- SendGrid email (optional) ---
# Without SENDGRID_API_KEY the alert is still logged; email is just skipped.
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.org
ALERT_EMAIL_TO=ses@example.gov.au,council@example.gov.au

# --- Optional model default override ---
# DEFAULT_MODEL=random_forest
